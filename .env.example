# Source (defaults shown)
LOCAL_ADDRESS=localhost:7233
LOCAL_NAMESPACE=default

# Target
CLOUD_ADDRESS=your-ns.tmprl.cloud:7233
CLOUD_NAMESPACE=your-ns

# Auth — set CLOUD_API_KEY or both CLOUD_TLS_CERT + CLOUD_TLS_KEY
CLOUD_API_KEY=
# CLOUD_TLS_CERT=/certs/client.pem
# CLOUD_TLS_KEY=/certs/client.key

# Set to 1 to delete existing target schedules by ID before recreating
# OVERWRITE=1
